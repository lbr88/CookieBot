{
  "name": "cookiebot",
  "version": "2.052-106",
  "description": "Automated bot for Cookie Clicker game",
  "main": "dist/cookieAutoPlayBeta.js",
  "scripts": {
    "build": "node scripts/bump-version.js && webpack --mode production && node scripts/post-build.js && node scripts/build-userscript.js",
    "cleanup": "node scripts/cleanup-builds.js",
    "dev": "webpack --mode development --watch",
    "type-check": "tsc --noEmit",
    "test": "node tests/run_all.js",
    "test:e2e": "node tests/e2e.js",
    "test:modules": "node tests/modules/all_modules_test.js",
    "test:saves": "node tests/integration/bot_decisions.test.js",
    "start:game": "node scripts/run-game.js",
    "start:game:firefox": "node scripts/run-game.js --firefox",
    "start:headless": "node scripts/run-game.js --headless",
    "start:headless:firefox": "node scripts/run-game.js --headless --firefox"
  },
  "keywords": [
    "cookie-clicker",
    "automation",
    "bot"
  ],
  "author": "lbr88",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "puppeteer": "^24.34.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}
